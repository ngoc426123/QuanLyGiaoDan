# Environment Configuration

CI_ENVIRONMENT = development

# App
app.baseURL = 'http://localhost:8080/'

# Database (MySQL) - commented out because using SQLite
# database.default.hostname = localhost
# database.default.port = 3306
# database.default.database = quanlygiaodan
# database.default.username = root
# database.default.password =
# database.default.DBDriver = MySQLi
# database.default.charset = utf8mb4
# database.default.DBCollat = utf8mb4_general_ci

# SQLite configuration: the database file will be stored in public/databases/database.sqlite
database.default.DBDriver = SQLite3
database.default.database = public/databases/database.sqlite

# Optional: better error visibility in dev
logger.threshold = 4
